  -----------------------Pivot Example--------------------------
  SELECT *
FROM (
  select useruid as staff_id, OwlASMUID1 as parent_staff_id, 'asm' as parent_staff_role  from dev_10_bronze.dwh.dbo_mi_insight_userhierarchyallusers where OwlASMUID1 is not null and LatestRowInd = '1'
union all
select useruid as staff_id, OwlASMUID2 as parent_staff_id, 'esm' as parent_staff_role  from dev_10_bronze.dwh.dbo_mi_insight_userhierarchyallusers where OwlASMUID2 is not null and LatestRowInd = '1'
union all
select useruid as staff_id, SupervisorUID as parent_staff_id, 'supervisor' as parent_staff_role  from dev_10_bronze.dwh.dbo_mi_insight_userhierarchyallusers where SupervisorUID is not null and LatestRowInd = '1'
union all
select ag.code as staff_id, ag.RecruitedByCode as parent_staff_id, 'introducer' as parent_staff_role
from dev_10_bronze.dwh.dbo_mstt_agents ag join dev_10_bronze.dwh.dbo_cscv_agentshierarchy introd on ag.RecruitedByCode = introd.AgentCode
union all
select useruid as staff_id, AQMUID as parent_staff_id, 'aqm' as parent_staff_role  from dev_10_bronze.dwh.dbo_mi_insight_userhierarchyallusers where AQMUID is not null and LatestRowInd = '1'
union all
select useruid as staff_id, BQMUID as parent_staff_id, 'bqm' as parent_staff_role  from dev_10_bronze.dwh.dbo_mi_insight_userhierarchyallusers where BQMUID is not null and LatestRowInd = '1'
) AS source
PIVOT (
  max(parent_staff_id)
  FOR parent_staff_role IN ('asm', 'esm', 'supervisor', 'introducer', 'aqm', 'bqm')
